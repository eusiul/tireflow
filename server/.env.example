# =============================================
# TireFlow Server — Environment Variables
# Copy to .env and fill in values
# =============================================

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tireflow

# JWT
JWT_SECRET=change-me-to-a-long-random-string-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# =============================================
# 1. PIX — Efi Bank (Gerencianet)
# https://dev.efipay.com.br/
# =============================================
EFI_CLIENT_ID=your_client_id_here
EFI_CLIENT_SECRET=your_client_secret_here
EFI_PIX_KEY=your_pix_key_here        # e.g. CNPJ or random key
EFI_SANDBOX=true                      # false in production
EFI_WEBHOOK_SECRET=random_webhook_token

# =============================================
# 2. NF-e — Focus NF-e
# https://focusnfe.com.br/
# =============================================
FOCUS_NFE_TOKEN=your_focus_nfe_token_here
FOCUS_NFE_SANDBOX=true               # false in production
# CNPJ/IE do emitente ficam por tenant (tabela tenants)

# =============================================
# 3. WhatsApp — Evolution API (self-hosted)
# https://github.com/EvolutionAPI/evolution-api
# =============================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=tireflow-main     # nome da instância

# =============================================
# AI — Claude API (Anthropic)
# https://console.anthropic.com/
# =============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Storage (Cloudflare R2 ou AWS S3)
S3_ENDPOINT=https://account.r2.cloudflarestorage.com
S3_BUCKET=tireflow-uploads
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_PUBLIC_URL=https://uploads.tireflow.com.br

# Email (Resend)
RESEND_API_KEY=your_resend_key
EMAIL_FROM=noreply@tireflow.com.br
